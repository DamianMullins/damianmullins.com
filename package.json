{
  "name": "damianmullins",
  "description": "Development Blog for Damian mullins - Senior Software Engineer.",
  "homepage": "https://www.damianmullins.com",
  "version": "5.1.7",
  "author": "Damian Mullins <damian@mullins.in> (https://www.damianmullins.com)",
  "keywords": [
    "astro",
    "blog"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:DamianMullins/damianmullins.com.git"
  },
  "scripts": {
    "clean": "rimraf dist .astro",
    "start": "PUBLIC_RELEASE_VERSION=$npm_package_version astro dev",
    "format": "prettier --write .",
    "build": "pnpm run clean && PUBLIC_RELEASE_VERSION=$npm_package_version astro build",
    "serve": "astro preview",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:content": "vitest run tests/content.test.ts",
    "test:build": "vitest run tests/build.test.ts tests/html.test.ts"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@sentry/astro": "^10.52.0",
    "@sentry/browser": "^10.49.0",
    "@sentry/node": "^10.49.0",
    "astro": "^6.1.9",
    "logrocket": "12.1.0",
    "mdast-util-to-string": "^4.0.0",
    "reading-time": "^1.5.0",
    "rehype-slug": "^6.0.0",
    "sharp": "^0.34.5",
    "slugify": "1.6.9"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.11.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.12.2",
    "cheerio": "^1.2.0",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rimraf": "6.1.3",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "browserslist": [
    ">0.3%",
    "last 2 versions",
    "not dead"
  ],
  "pnpm": {
    "overrides": {
      "yaml": ">=2.8.3"
    }
  },
  "packageManager": "pnpm@10.33.1+sha512.05ba3c1d5d1c18f68df06470d74055e62d41fc110a0c660db1b2dfb2785327f04cf0f68345d4609bc52089e7fa0343c31593b2f9594e2c5d5da426230acc9820"
}
